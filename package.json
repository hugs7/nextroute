{
  "name": "next-typed-paths",
  "version": "0.3.4",
  "description": "A realtime typesafe Next.Js route generation tool",
  "keywords": [
    "nextjs",
    "routes",
    "typescript",
    "type-safe",
    "app-router"
  ],
  "homepage": "https://github.com/hugs7/next-typed-paths#readme",
  "bugs": {
    "url": "https://github.com/hugs7/next-typed-paths/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugs7/next-typed-paths.git"
  },
  "license": "MIT",
  "author": "Hugo Burton",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "next-typed-paths": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "require": "./dist/runtime/index.cjs",
      "default": "./dist/runtime/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "require": "./dist/contracts/index.cjs",
      "default": "./dist/contracts/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.cjs",
      "default": "./dist/client/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js",
      "require": "./dist/next/index.cjs",
      "default": "./dist/next/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "tsc": "tsc -p tsconfig.lib.json",
    "build": "npm run tsc && vite build",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "test:e2e": "npm run build --silent && node dist/cli.js generate --config ./test/routes.config.ts",
    "test:e2e:watch": "npm run test:e2e -- --watch"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "cosmiconfig": "^9.0.1",
    "lodash-es": "^4.18.1",
    "prettier": "^3.8.3",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.6.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.0.0",
    "vite": "^8.0.11",
    "vitest": "^4.1.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0",
    "zod": ">=4.0.0 <5.0.0"
  }
}
